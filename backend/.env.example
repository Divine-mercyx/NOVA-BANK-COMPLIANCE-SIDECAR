# PostgreSQL (Docker Compose default)
DATABASE_URL=postgresql+asyncpg://nova:nova_dev@localhost:5433/nova_staging
SYNC_DATABASE_URL=postgresql+psycopg2://nova:nova_dev@localhost:5433/nova_staging

# Finacle extract — use oracle on VPN laptop
FINACLE_MODE=oracle
FINACLE_ORACLE_SOURCE=htd
FINACLE_ADMIN_SCHEMA=TBAADM
FINACLE_SCHEMA=CUSTOM
FINACLE_ORACLE_DSN=host:1521/service_name
FINACLE_ORACLE_USER=readonly_user
FINACLE_ORACLE_PASSWORD=change_me

# Offline dev (no VPN): FINACLE_MODE=csv

# API
API_BASE_URL=http://localhost:8000

# Optional: daily ETL cron (UTC)
ETL_SCHEDULE_ENABLED=false
ETL_SCHEDULE_HOUR=2
ETL_SCHEDULE_MINUTE=0

# Auth (change in production)
JWT_SECRET=nova-dev-secret-change-in-production
ADMIN_EMAIL=admin@novabank.ng
ADMIN_PASSWORD=Admin@Nova2026
